# Environment / credentials — never commit real keys
.env
auth.json
instances.json

# Runtime state (probe results / ratings cache) — regenerated on start
router_state.json

# Persistent response cache (CACHE_PERSIST=1) — can contain real prompt/response
# content, never commit it
cache.db
usage.db
usage.db-shm
usage.db-wal
*.db-journal

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
router.log
router.pid
# Graph extraction caches and machine-specific interpreter/mtime metadata
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/manifest.json
.claude/settings.json
