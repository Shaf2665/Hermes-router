# Tip: the optional add-ons below (semantic/persistent cache, fast routing, cost
# currency, metrics auth…) can also be toggled with `hr features enable|disable <name>`
# — see `hr features list` and the Configuration docs. Core features are always on.

# ── Authentication ─────────────────────────────────────────────────────────────
# Keys that clients use to authenticate with hermes-router — and the key needed
# to open the web dashboard (comma-separated for multiple). You don't need to
# change the placeholder below: if it's left as-is (or unset), the router
# generates a real random key on first boot and saves it back to this file,
# logging it once so you can copy it. Set your own value here instead if you'd
# rather choose it yourself.
PROXY_API_KEYS=sk-my-router-key-1

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8319
# Bind address. Default 0.0.0.0 (needed for Docker). On a shared/VPS host, set
# 127.0.0.1 to listen on localhost only and reach it via an SSH tunnel.
# HOST=127.0.0.1
LOG_LEVEL=INFO
# To survive reboots, install a boot service:  hr service install
# (systemd unit name; also used by `hr restart`). Override the name if you run more than one:
# HERMES_ROUTER_SERVICE=hermes-router

# ── Provider API Keys ──────────────────────────────────────────────────────────
# Add multiple keys per provider for higher throughput and fewer rate-limit hits.
# Providers tried in order: Gemini → OpenRouter → SambaNova → GitHub Models → Cerebras → Groq → Mistral → Cohere → Z.ai (GLM) → Naga → NVIDIA NIM
# Any provider with no keys configured is skipped automatically.
#
# Three ways to supply multiple keys (all are combined automatically):
#   GROQ_API_KEY=key1                   # single key
#   GROQ_API_KEYS=key1,key2,key3        # comma-separated
#   GROQ_API_KEY_2=key2                 # numbered suffixes (_2, _3, ...)

# Google Gemini (free tier, resets per minute — get keys at aistudio.google.com)
GEMINI_API_KEYS=AIzaSy_key1,AIzaSy_key2,AIzaSy_key3

# OpenRouter (50 free requests/day per key — get keys at openrouter.ai)
OPENROUTER_API_KEYS=sk-or-key1,sk-or-key2

# SambaNova (free, fast Llama models — get key at cloud.sambanova.ai)
SAMBANOVA_API_KEY=your-sambanova-key

# GitHub Models (free with any GitHub account — use a GitHub PAT or OAuth token)
# Generate at: github.com/settings/tokens (no special scopes needed)
GITHUB_MODELS_TOKEN=ghp_or_gho_your-token

# Cerebras (fast inference, free tier — get key at cloud.cerebras.ai)
CEREBRAS_API_KEY=csk-your-key

# Groq (fast inference, free tier — get key at console.groq.com)
GROQ_API_KEY=gsk_your-key

# Mistral (free tier, mistral-medium-latest — get key at console.mistral.ai)
MISTRAL_API_KEY=your-mistral-key

# Cohere (free trial, 1000 calls/mo per key, command-a 256K ctx — get key at dashboard.cohere.com)
COHERE_API_KEY=your-cohere-key

# Z.ai / GLM (free, glm-4.5-flash, ~1k req/day — get key at z.ai)
GLM_API_KEY=your-zai-key

# Naga AI (free, Nemotron-3-Super-120B, 100 req/day per key — get key at naga.ac)
NAGA_API_KEY=ng-your-key
# NAGA_API_KEY_2=ng-second-key
# NAGA_API_KEY_3=ng-third-key

# NVIDIA NIM (free, DeepSeek V4 Flash, 1M context, 40 req/min per key — get key at build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-key
# NVIDIA_API_KEY_2=nvapi-second-key
# NVIDIA_API_KEY_3=nvapi-third-key

# ── Model Overrides (optional) ─────────────────────────────────────────────────
# Uncomment to use a different model for any provider.
# A provider can use MULTIPLE models — give a comma-separated list. Rate limits
# are per-model, so the router fails over across them (each its own quota) before
# moving to the next provider. First model = primary for startup display; routing
# and tool/reasoning support are tracked per model.
#   e.g.  GEMINI_MODEL=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-2.0-flash
# GEMINI_MODEL=gemini-2.5-flash-lite
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# SAMBANOVA_MODEL=DeepSeek-V3.2
# GITHUB_MODELS_MODEL=gpt-4o            # gpt-4o-mini for a lighter, higher-quota option
# CEREBRAS_MODEL=gpt-oss-120b
# GROQ_MODEL=llama-3.3-70b-versatile
# MISTRAL_MODEL=mistral-medium-latest
# COHERE_MODEL=command-a-03-2025
# ZAI_MODEL=glm-4.5-flash
# NAGA_MODEL=nemotron-3-super-120b-a12b:free   # or nemotron-3-ultra-550b-a55b:free (slower)
# NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash
# Kimi (Moonshot) coding plan — add the API key with: hr auth add kimi
# KIMI_MODEL=kimi-for-coding
# KIMI_BASE_URL=https://api.kimi.com/coding/v1   # or https://api.moonshot.ai/v1 for the standard API

# OpenCode Zen — OpenAI-compatible coding-model gateway with FREE models. One key
# (opencode.ai → API Keys) added with: hr auth add opencode
# Default uses free models; free promos rotate, so the router skips ended ones and
# fails over. Premium models (claude/gpt/gemini/…) work too via OPENCODE_MODEL.
# OPENCODE_MODEL=deepseek-v4-flash-free,minimax-m3-free,qwen3.6-plus-free
# OpenCode Go — the low-cost subscription tier ($5 first mo, then $10/mo), SAME key,
# different endpoint. IMPORTANT: only add a key here (OPENCODE_GO_API_KEYS / hr auth
# add opencode_go) AFTER enabling Go billing on opencode.ai — its presence is the
# router's only signal that you've subscribed. Adding it without Go billing enabled
# means every request to this provider will fail with an auth error (the router
# will back off after repeated failures, but it'll never actually work) — if you
# haven't subscribed, don't set this at all; OPENCODE_MODEL above already covers
# OpenCode's free tier.
# OPENCODE_GO_MODEL=deepseek-v4-flash,minimax-m3

# ── Local model (optional) ────────────────────────────────────────────────────
# Route to a model running on your own machine (Ollama, LM Studio, llama.cpp, …) —
# free, private, fast. Enabled by setting LOCAL_BASE_URL or LOCAL_MODEL. Local
# servers are keyless, so no key is needed (a harmless sentinel is used internally).
# LOCAL_BASE_URL=http://localhost:11434/v1     # Ollama default; LM Studio: http://localhost:1234/v1
# LOCAL_MODEL=llama3.1                          # any model your server has pulled (comma-list ok)
# LOCAL_API_KEY=local                           # only if your local server actually requires one
# LOCAL_EMBED_MODEL=nomic-embed-text            # optional: also serve /v1/embeddings locally
#
# "Conversation mode": send model `hermes-router:fast` (or header X-Hermes-Profile: fast)
# to prefer the local model for short/casual turns, with the cloud providers as fallback.

# ── OpenRouter Metadata (optional) ────────────────────────────────────────────
# OPENROUTER_SITE_URL=https://your-site.com
# OPENROUTER_APP_NAME=my-app

# ── Router Model ID (optional) ────────────────────────────────────────────────
# The model name advertised at /v1/models and accepted in requests.
# ROUTER_MODEL_ID=hermes-router

# ── Per-key budgets & rate limits (optional) ──────────────────────────────────
# Give each PROXY_API_KEYS entry a ceiling so the router is safe to share. These
# are global defaults; set per-key overrides in auth.json with `hr limit set`.
# 0 = unlimited (default → no enforcement, exactly like before).
# PROXY_LIMIT_RPM=0             # requests per minute, per key (rolling 60s window)
# PROXY_LIMIT_REQ_DAY=0         # requests per UTC day, per key
# PROXY_LIMIT_TOKENS_DAY=0      # tokens per UTC day, per key
# PROXY_LIMIT_COST_DAY=0        # estimated USD cost per UTC day, per key
# Per-key example (auth.json):
#   { "proxy_keys": { "sk-team-1": { "rpm": 60, "req_per_day": 500, "tokens_per_day": 100000, "cost_per_day": 5 } } }

# ── Cost / spend awareness (optional) ─────────────────────────────────────────
# The router estimates spend from a built-in price table (USD per 1M tokens);
# free providers and subscription plans (Codex, Kimi coding) are $0. Spend shows
# in /v1/usage, /v1/status, the dashboard, and /metrics. USD is always canonical.
# Set an FX rate + currency to ALSO surface a converted figure (e.g. ₹):
# COST_CURRENCY=INR
# COST_FX_RATE=83
# Correct/extend prices without editing code (JSON: {"model-substr": [in, out]}):
# MODEL_PRICES_FILE=./prices.json

# ── Response Cache (optional) ─────────────────────────────────────────────────
# Cache identical requests' responses to save free-tier quota.
# Entries are namespaced by the caller's API key, so different PROXY_API_KEYS
# never share a cached answer for the same prompt (safe for multi-tenant use).
# Set to 0 to disable caching entirely.
# CACHE_TTL_SECONDS=300
# CACHE_MAX_SIZE=100
# Persistent cache: mirror the cache to a SQLite file so it survives restarts
# (opt-in). The DB mirrors the in-memory LRU, so it stays bounded by CACHE_MAX_SIZE
# — raise that to persist more. On read-only hosts (e.g. HF Spaces) point the path
# at /tmp/cache.db. Leave off for the default in-memory-only cache.
# CACHE_PERSIST=1
# CACHE_DB_PATH=./cache.db
# Semantic cache: also serve a cached answer for a *similar* (not just identical)
# prompt, by embedding prompts and comparing cosine similarity. Opt-in; needs an
# embedding-capable provider (e.g. Gemini/Mistral, or LOCAL_EMBED_MODEL). Falls back
# to exact-match when off. Raise the threshold for stricter matches (1.0 = identical).
# SEMANTIC_CACHE=1
# SEMANTIC_CACHE_THRESHOLD=0.95

# ── Fast Routing (optional) ───────────────────────────────────────────────────
# For short requests below this estimated token count, low-latency providers
# (Groq, Cerebras, SambaNova) win ties between equally-rated providers.
# Set to 0 (default) to disable.
# FAST_ROUTE_THRESHOLD=200

# ── Model Discovery (optional) ────────────────────────────────────────────────
# At startup, fetch /models from configured OpenAI-compatible providers, prune
# configured models that are no longer listed, and append the best discovered
# models up to this limit. Opt-in because some gateways expose paid or huge model
# catalogs. Mixed free/paid gateways are filtered to free model ids where known.
# AUTO_DISCOVER_MODELS=1
# AUTO_DISCOVER_MODEL_LIMIT=8
# Per-provider override, useful for skipped large catalogs:
# HUGGINGFACE_AUTO_DISCOVER_MODELS=1

# ── Per-provider exclude list (optional) ────────────────────────────────────
# Block specific model IDs for a provider so they are never used for routing.
# Useful when auto-discovery re-adds a model you don't want, or you want to
# keep a model out of rotation without removing the env var. If every model is
# excluded, the provider stays visible in status but is skipped for routing.
# {PROVIDER}_EXCLUDE_MODELS — comma-separated, case-insensitive exact match.
# OPENROUTER_EXCLUDE_MODELS=some/unwanted-model:free
# MISTRAL_EXCLUDE_MODELS=mistral-tiny

# ── Provider probe cache (optional) ───────────────────────────────────────────
# Startup probes spend one tiny completion per provider. Saved results are
# reused for this many hours before re-probing (0 = re-probe on every start).
# ROUTER_STATE_TTL_HOURS=24
# Where that cached state is written. Use a writable path (e.g. /tmp) on
# read-only/ephemeral hosts like Hugging Face Spaces.
# ROUTER_STATE_FILE=./router_state.json

# ── Server / limits (optional) ────────────────────────────────────────────────
# Worker threads for the waitress server (concurrency). The upstream HTTP
# connection pool scales with this automatically.
# WORKER_THREADS=16
# Max request body size in bytes; larger requests are rejected with 413. Guards
# against a buggy client exhausting memory. Default 10 MB.
# MAX_REQUEST_BYTES=10485760

# ── Large-payload skip (optional) ─────────────────────────────────────────────
# Some free tiers reject big requests outright (e.g. Groq's free tier caps
# tokens-per-minute around 6000 and returns 413). hermes-router skips such a
# provider when your request is estimated to exceed its ceiling, avoiding a
# wasted failed attempt before cascading on.
#   {PROVIDER}_SKIP_TOKENS_OVER  — set 0 to disable, or raise it on a paid tier.
# Sensible defaults are built in even if you don't set these; override here:
# GROQ_SKIP_TOKENS_OVER=5500            # ~6K TPM free tier → 413
# SAMBANOVA_SKIP_TOKENS_OVER=30000      # DeepSeek-V3.2 here caps at 32K context → 400
# GITHUB_MODELS_SKIP_TOKENS_OVER=6000   # gpt-4o free tier ~8K input limit → 413
# CEREBRAS_SKIP_TOKENS_OVER=0

# Some providers reject the WHOLE request with a 400 if max_tokens exceeds their
# output cap (e.g. a client sending max_tokens=65536). hermes-router clamps the
# requested output down to the provider's ceiling so the call still succeeds.
#   {PROVIDER}_MAX_OUTPUT_TOKENS  — set 0 to disable the clamp.
# COHERE_MAX_OUTPUT_TOKENS=8192          # command-a caps output at 8192
# GITHUB_MODELS_MAX_OUTPUT_TOKENS=16384  # gpt-4o here rejects very large max_tokens

# ── Circuit breaker (optional) ────────────────────────────────────────────────
# A provider that fails health checks repeatedly (network errors or 5xx — not
# rate-limits or bad requests) is tripped out of rotation for a cooldown, then
# probed again. Unhealthy providers also sink in the routing order automatically.
# Defaults shown; uncomment to tune.
# BREAKER_WINDOW=8           # how many recent outcomes to weigh
# BREAKER_MIN_SAMPLES=4      # min samples before the breaker can trip
# BREAKER_ERROR_RATE=0.5     # trip when >= this fraction of the window are health-fails
# BREAKER_COOLDOWN=60        # seconds the breaker stays open before re-probing
