{
  "name": "hermes-router",
  "displayName": "hermes-router",
  "description": "Control panel for hermes-router — monitor provider health and manage your multi-provider AI router from VS Code.",
  "version": "0.9.4",
  "publisher": "MohammedShafiq",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shaf2665/Hermes-router.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": ["Other"],
  "keywords": ["hermes-router", "llm", "openai", "proxy", "load balancer", "ai"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "hermes-router",
        "displayName": "hermes-router"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hermesRouter",
          "title": "hermes-router",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "hermesRouter": [
        {
          "id": "hermesRouter.dashboard",
          "name": "Dashboard",
          "type": "webview"
        }
      ]
    },
    "commands": [
      { "command": "hermesRouter.openDashboard", "title": "hermes-router: Open Dashboard" },
      { "command": "hermesRouter.openWebDashboard", "title": "hermes-router: Open Web Dashboard (browser)", "icon": "$(globe)" },
      { "command": "hermesRouter.refresh", "title": "hermes-router: Refresh Status", "icon": "$(refresh)" },
      { "command": "hermesRouter.restart", "title": "hermes-router: Restart Router" },
      { "command": "hermesRouter.doctor", "title": "hermes-router: Run Doctor (diagnose)" },
      { "command": "hermesRouter.update", "title": "hermes-router: Update to Latest" },
      { "command": "hermesRouter.importCodex", "title": "hermes-router: Import Codex (ChatGPT) Login" }
    ],
    "menus": {
      "view/title": [
        { "command": "hermesRouter.openWebDashboard", "when": "view == hermesRouter.dashboard", "group": "navigation@1" },
        { "command": "hermesRouter.refresh", "when": "view == hermesRouter.dashboard", "group": "navigation@2" }
      ]
    },
    "configuration": {
      "title": "hermes-router",
      "properties": {
        "hermesRouter.baseUrl": {
          "type": "string",
          "default": "http://localhost:8319",
          "description": "Base URL of the running hermes-router (use your Space URL for a remote router; CLI controls are disabled when remote)."
        },
        "hermesRouter.apiKey": {
          "type": "string",
          "default": "",
          "description": "A value from the router's PROXY_API_KEYS. Fresh routers generate one on first boot; copy it from .env or the startup log."
        },
        "hermesRouter.hrPath": {
          "type": "string",
          "default": "hr",
          "description": "Path to the `hr` CLI (used for local control actions)."
        },
        "hermesRouter.dockerContainer": {
          "type": "string",
          "default": "",
          "description": "Name (or ID) of the Docker container running hermes-router. When set, control actions run via `docker exec <container> hr …` and Restart runs `docker restart <container>`. Requires the `:cli` image (e.g. shafiq735/hermes-router:cli) with a mounted volume so changes persist. Leave blank for a non-Docker local install."
        },
        "hermesRouter.refreshSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 3,
          "description": "How often to refresh the dashboard and status bar (seconds)."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.104.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0"
  }
}
