# hermes-router :cli — same router, plus the `hr` CLI bundled inside the image.
#
# This variant exists so the VS Code extension's "Docker mode" can manage the
# router with `docker exec <container> hr …` (add keys, set model/rotation) and
# `docker restart <container>` to apply. Mutable config lives on a volume at
# /app/data, so keys/model/rotation survive container recreation.
#
# Run it with a volume:
#   docker run -d --name hermes-router -p 8319:8319 \
#     -v hermes-data:/app/data -e PROXY_API_KEYS=replace-with-a-long-random-secret \
#     shafiq735/hermes-router:cli
FROM python:3.12-slim

LABEL org.opencontainers.image.title="Hermes Router CLI" \
      org.opencontainers.image.description="Hermes Router with bundled hr CLI for Docker-managed installs" \
      org.opencontainers.image.source="https://github.com/Shaf2665/Hermes-router" \
      org.opencontainers.image.licenses="MIT"

ENV PYTHONUNBUFFERED=1

# bash (the hr scripts) + curl (hr status/doctor health checks).
RUN apt-get update \
 && apt-get install -y --no-install-recommends bash curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY router.py hermes-router ./
COPY scripts ./scripts

# Backing files for `hr hall` (advisory bridge) and `hr agent` (Hermes Coding
# Runtime). Without these the two subcommands exit with "No such file".
COPY hermes_hall_bridge.py hermes_router_client.py hermes_agent_runner.py ./
COPY hermes_agent ./hermes_agent

# Put `hr` (and the full name) on PATH.
RUN chmod +x hermes-router scripts/*.sh \
 && ln -s /app/hermes-router /usr/local/bin/hr \
 && ln -s /app/hermes-router /usr/local/bin/hermes-router

# Persist mutable config on a volume. auth.json + runtime state are redirected
# there via env vars; .env is a symlink so `hr mode` / `hr model set` (which
# write $REPO/.env) land on the volume too, and the router reads it back.
RUN mkdir -p /app/data && ln -s /app/data/.env /app/.env
ENV ROUTER_AUTH_FILE=/app/data/auth.json \
    ROUTER_STATE_FILE=/app/data/router_state.json
VOLUME ["/app/data"]

# Port 8319 serves the API (/v1/*), /health, /metrics, and the built-in
# monitoring dashboard (open http://localhost:8319/ in a browser).
EXPOSE 8319

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/health' % os.environ.get('PORT','8319'), timeout=4)"

CMD ["python", "router.py"]
